(defpoll time :interval "1s"
  "date '+%I:%M %p'")

(defpoll weekday :interval "60s"
  "date '+%A'")

(defpoll full_date :interval "60s"
  "date '+%B %-d, %Y'")

(defwidget fancy_calendar []
  (box :class "calendar-panel"
       :orientation "vertical"
       :space-evenly false
       :spacing 10

    (label :class "calendar-time"
           :text time)

    (label :class "calendar-date"
           :text "${weekday}, ${full_date}")

    (box :class "calendar-divider")

    (calendar :class "calendar-widget"
              :show-details false
              :show-heading true
              :show-day-names true
              :show-week-numbers false)
  )
)

(defwindow fancy_calendar
  :geometry (geometry
    :x "0px"
    :y "42px"
    :width "420px"
    :height "440px"
    :anchor "top center")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (fancy_calendar))

  (defwidget calendar_backdrop []
  (eventbox :class "calendar-backdrop"
            :onclick "eww close fancy_calendar && eww close backdrop0 && eww close backdrop1"
    (box)))

(defwindow calendar_backdrop
  :geometry (geometry
    :x "0px"
    :y "0px"
    :width "100%"
    :height "100%"
    :anchor "center")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (calendar_backdrop))


