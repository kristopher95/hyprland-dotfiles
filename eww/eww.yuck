(defpoll time :interval "1s"
  "date '+%I:%M %p'")

(defpoll weekday :interval "60s"
  "date '+%A'")

(defpoll full_date :interval "60s"
  "date '+%B %-d, %Y'")

(defpoll volume :interval "1s"
  "pamixer --get-volume")

(defpoll muted :interval "1s"
  "pamixer --get-mute")

(defpoll audio_outputs :interval "2s"
  "~/.config/eww/scripts/audio_outputs.sh")

(defpoll audio_inputs :interval "2s"
  "~/.config/eww/scripts/audio_inputs.sh")


(defwidget fancy_calendar []
  (box :class "calendar-panel"
       :orientation "vertical"
       :space-evenly false
       :spacing 10

    (label :class "calendar-time"
           :text time)

    (label :class "calendar-date"
           :text "${weekday}, ${full_date}")

    (box :class "calendar-divider")

    (calendar :class "calendar-widget"
              :show-details false
              :show-heading true
              :show-day-names true
              :show-week-numbers false)
  )
)


(defwidget volume_popup []
  (box :class "volume-panel"
       :orientation "vertical"
       :space-evenly false
       :spacing 14

    (box :class "volume-header"
         :orientation "horizontal"
         :space-evenly false
         :spacing 12

      (button :class "volume-mute-button"
              :onclick "pamixer --toggle-mute"
        (label :text {muted == "true" ? "󰖁" : "󰕾"}))

      (label :class "volume-title"
             :text "Volume")

      (label :class "volume-percent"
             :text "${volume}%")
    )

    (scale :class "volume-slider"
       :min 0
       :max 100
       :value volume
       :onchange "pamixer --set-volume {}; eww update volume={}")

    (box :orientation "vertical"
         :space-evenly false
         :spacing 14

      (box :class "audio-section"
           :orientation "vertical"
           :space-evenly false
           :spacing 6
        (label :class "audio-section-title"
               :text "OUTPUTS")
        (literal :content audio_outputs)
      )

      (box :class "audio-section"
           :orientation "vertical"
           :space-evenly false
           :spacing 6
        (label :class "audio-section-title"
               :text "INPUTS")
        (literal :content audio_inputs)
      )
    )

    (button :class "open-mixer-button"
            :onclick "pavucontrol >/dev/null 2>&1 & eww close volume_popup; eww close backdrop0; eww close backdrop1"
      (label :text "Open Full Mixer"))
  )
)


(defwindow fancy_calendar
  :geometry (geometry
    :x "0px"
    :y "42px"
    :width "560px"
    :height "520px"
    :anchor "top center")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (fancy_calendar))


(defwindow volume_popup
  :geometry (geometry
    :x "18px"
    :y "42px"
    :width "460px"
    :height "560px"
    :anchor "top right")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (volume_popup))


(defwidget calendar_backdrop []
  (eventbox :class "calendar-backdrop"
    :onclick "eww close fancy_calendar; eww close volume_popup; eww close backdrop0; eww close backdrop1"
    (box)))


(defwindow calendar_backdrop
  :geometry (geometry
    :x "0px"
    :y "0px"
    :width "100%"
    :height "100%"
    :anchor "center")
  :stacking "overlay"
  :exclusive false
  :focusable false
  (calendar_backdrop))
