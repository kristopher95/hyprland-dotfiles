{
    "output": "DP-3",
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 0,

    "modules-left": [
        "custom/ws1",
        "custom/ws2",
        "custom/ws3",
        "custom/ws4",
        "custom/ws5",
        "custom/ws6",
        "custom/ws7",
        "custom/ws8",
        "custom/spotify-window",
        "custom/spotify-prev",
        "custom/spotify-toggle",
        "custom/spotify-next",
        "custom/spotify-vol-down",
        "custom/spotify-volume",
        "custom/spotify-vol-up",
        "custom/spotify-title",
        "custom/audio-bars"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "custom/ram_compact",
        "custom/cpu_compact",
        "custom/gpu_compact",
        "pulseaudio",
        "custom/power"
    ],

    "custom/ws1": {
        "format": "1",
        "tooltip": false,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"1\" })'"
    },

    "custom/ws2": {
        "format": "2",
        "tooltip": false,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"2\" })'"
    },

    "custom/ws3": {
        "format": "3",
        "tooltip": false,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"3\" })'"
    },

    "custom/ws4": {
        "format": "4",
        "tooltip": false,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"4\" })'"
    },

    "custom/ws5": {
        "format": "5",
        "tooltip": false,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"5\" })'"
    },

    "custom/ws6": {
        "format": "6",
        "tooltip": false,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"6\" })'"
    },

    "custom/ws7": {
        "format": "7",
        "tooltip": false,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"7\" })'"
    },

    "custom/ws8": {
        "format": "8",
        "tooltip": false,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"8\" })'"
    },

    "clock": {
        "format": "{:%I:%M %p}",
        "tooltip-format": "{:%A, %B %d, %Y}",
        "on-click": "~/.scripts/toggle_calendar.sh"
    },

    "custom/ram_compact": {
        "exec": "~/.config/waybar/scripts/ram_compact.sh",
        "interval": 2,
        "tooltip": false
    },

    "custom/cpu_compact": {
        "exec": "~/.config/waybar/scripts/cpu_compact.sh",
        "interval": 2,
        "tooltip": false
    },

    "custom/gpu_compact": {
        "exec": "~/.config/waybar/scripts/gpu_compact.sh",
        "interval": 2,
        "tooltip": false
    },

    "pulseaudio": {
        "format": "[V:{volume}%]",
        "format-muted": "[V:M]",
        "on-click": "~/.scripts/toggle_volume.sh",
        "on-click-right": "pavucontrol",
        "tooltip": false
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "~/.config/waybar/power_menu.xml",
        "menu-actions": {
            "lock": "hyprlock",
            "suspend": "systemctl suspend",
            "reboot": "systemctl reboot",
            "shutdown": "systemctl poweroff"
        }
    },

    "custom/spotify-prev": {
        "format": "󰒮",
        "on-click": "playerctl -p spotify previous",
        "tooltip": false
    },

    "custom/spotify-toggle": {
        "exec": "~/.config/waybar/scripts/spotify_status.sh",
        "interval": 1,
        "on-click": "playerctl -p spotify play-pause",
        "tooltip": false
    },

    "custom/spotify-next": {
        "format": "󰒭",
        "on-click": "playerctl -p spotify next",
        "tooltip": false
    },

    "custom/spotify-vol-down": {
        "format": "󰝞",
        "on-click": "playerctl -p spotify volume 0.05-",
        "tooltip": false
    },

    "custom/spotify-volume": {
        "exec": "~/.config/waybar/scripts/spotify_volume.sh",
        "interval": 1,
        "on-scroll-up": "playerctl -p spotify volume 0.05+",
        "on-scroll-down": "playerctl -p spotify volume 0.05-",
        "tooltip": false
    },

    "custom/spotify-vol-up": {
        "format": "󰝝",
        "on-click": "playerctl -p spotify volume 0.05+",
        "tooltip": false
    },

    "custom/spotify-title": {
        "exec": "~/.config/waybar/scripts/spotify_title.sh",
        "interval": 1,
        "return-type": "json",
        "tooltip": true
    },

    "custom/audio-bars": {
        "exec": "~/.config/waybar/scripts/audio_bars.sh",
        "tooltip": false
    },

    "custom/spotify-window": {
        "format": "",
        "on-click": "~/.scripts/toggle_spotify.sh",
        "tooltip": true,
        "tooltip-format": "Open / hide Spotify"
    }
}
