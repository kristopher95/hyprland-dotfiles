{
    "output": "DP-3",
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 0,

    "modules-left": [
        "custom/ws1",
        "custom/ws2",
        "custom/ws3",
        "custom/ws4",
        "custom/ws5",
        "custom/ws6",
        "custom/ws7",
        "custom/ws8"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "custom/ram_compact",
        "custom/cpu_compact",
        "custom/gpu_compact",
        "pulseaudio",
        "custom/power"
    ],

    "custom/ws1": {
        "exec": "~/.config/waybar/scripts/ws_button.sh 1 1",
        "return-type": "json",
        "escape": false,
        "interval": "once",
        "signal": 8,
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"1\" })' && pkill -RTMIN+8 waybar"
    },

    "custom/ws2": {
        "exec": "~/.config/waybar/scripts/ws_button.sh 2 2",
        "return-type": "json",
        "escape": false,
        "interval": "once",
        "signal": 8,
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"2\" })' && pkill -RTMIN+8 waybar"
    },

    "custom/ws3": {
        "exec": "~/.config/waybar/scripts/ws_button.sh 3 3",
        "return-type": "json",
        "escape": false,
        "interval": "once",
        "signal": 8,
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"3\" })' && pkill -RTMIN+8 waybar"
    },

    "custom/ws4": {
        "exec": "~/.config/waybar/scripts/ws_button.sh 4 4",
        "return-type": "json",
        "escape": false,
        "interval": "once",
        "signal": 8,
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"4\" })' && pkill -RTMIN+8 waybar"
    },

    "custom/ws5": {
        "exec": "~/.config/waybar/scripts/ws_button.sh 5 5",
        "return-type": "json",
        "escape": false,
        "interval": "once",
        "signal": 8,
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"5\" })' && pkill -RTMIN+8 waybar"
    },

    "custom/ws6": {
        "exec": "~/.config/waybar/scripts/ws_button.sh 6 6",
        "return-type": "json",
        "escape": false,
        "interval": "once",
        "signal": 8,
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"6\" })' && pkill -RTMIN+8 waybar"
    },

    "custom/ws7": {
        "exec": "~/.config/waybar/scripts/ws_button.sh 7 7",
        "return-type": "json",
        "escape": false,
        "interval": "once",
        "signal": 8,
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"7\" })' && pkill -RTMIN+8 waybar"
    },

    "custom/ws8": {
        "exec": "~/.config/waybar/scripts/ws_button.sh 8 8",
        "return-type": "json",
        "escape": false,
        "interval": "once",
        "signal": 8,
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"8\" })' && pkill -RTMIN+8 waybar"
    },

    "clock": {
        "format": "{:%I:%M %p}",
        "tooltip-format": "{:%A, %B %d, %Y}",
        "on-click": "~/.scripts/toggle_calendar.sh"
    },

    "custom/ram_compact": {
        "exec": "~/.config/waybar/scripts/ram_compact.sh",
        "interval": 2,
        "tooltip": false
    },

    "custom/cpu_compact": {
        "exec": "~/.config/waybar/scripts/cpu_compact.sh",
        "interval": 2,
        "tooltip": false
    },

    "custom/gpu_compact": {
        "exec": "~/.config/waybar/scripts/gpu_compact.sh",
        "interval": 2,
        "tooltip": false
    },

    "pulseaudio": {
        "format": "[V:{volume}%]",
        "format-muted": "[V:M]",
        "on-click": "~/.scripts/toggle_volume.sh",
        "on-click-right": "pavucontrol",
        "tooltip": false
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "~/.config/waybar/power_menu.xml",
        "menu-actions": {
            "lock": "hyprlock",
            "suspend": "systemctl suspend",
            "reboot": "systemctl reboot",
            "shutdown": "systemctl poweroff"
        }
    }
}
