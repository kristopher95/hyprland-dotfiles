{
    "output": "DP-3",
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 0,

    "modules-left": [
        "custom/ws1",
        "custom/ws2",
        "custom/ws3",
        "custom/ws4",
        "custom/ws5",
        "custom/ws6",
        "custom/ws7",
        "custom/ws8"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "custom/cpu_status",
        "memory",
        "custom/gpu_compact",
        "disk",
        "network",
        "pulseaudio",
        "tray",
        "custom/power"
    ],

    "custom/ws1": {
        "exec": "~/.config/waybar/scripts/ws_button.sh 1 1",
        "return-type": "json",
        "escape": false,
        "interval": "once",
        "signal": 8,
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"1\" })' && pkill -RTMIN+8 waybar"
    },

    "custom/ws2": {
        "exec": "~/.config/waybar/scripts/ws_button.sh 2 2",
        "return-type": "json",
        "escape": false,
        "interval": "once",
        "signal": 8,
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"2\" })' && pkill -RTMIN+8 waybar"
    },

    "custom/ws3": {
        "exec": "~/.config/waybar/scripts/ws_button.sh 3 3",
        "return-type": "json",
        "escape": false,
        "interval": "once",
        "signal": 8,
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"3\" })' && pkill -RTMIN+8 waybar"
    },

    "custom/ws4": {
        "exec": "~/.config/waybar/scripts/ws_button.sh 4 4",
        "return-type": "json",
        "escape": false,
        "interval": "once",
        "signal": 8,
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"4\" })' && pkill -RTMIN+8 waybar"
    },

    "custom/ws5": {
        "exec": "~/.config/waybar/scripts/ws_button.sh 5 5",
        "return-type": "json",
        "escape": false,
        "interval": "once",
        "signal": 8,
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"5\" })' && pkill -RTMIN+8 waybar"
    },

    "custom/ws6": {
        "exec": "~/.config/waybar/scripts/ws_button.sh 6 6",
        "return-type": "json",
        "escape": false,
        "interval": "once",
        "signal": 8,
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"6\" })' && pkill -RTMIN+8 waybar"
    },

    "custom/ws7": {
        "exec": "~/.config/waybar/scripts/ws_button.sh 7 7",
        "return-type": "json",
        "escape": false,
        "interval": "once",
        "signal": 8,
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"7\" })' && pkill -RTMIN+8 waybar"
    },

    "custom/ws8": {
        "exec": "~/.config/waybar/scripts/ws_button.sh 8 8",
        "return-type": "json",
        "escape": false,
        "interval": "once",
        "signal": 8,
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"8\" })' && pkill -RTMIN+8 waybar"
    },

    "clock": {
        "format": "{:%I:%M %p}",
        "tooltip-format": "{:%A, %B %d, %Y\n\n%I:%M:%S %p}",
        "interval": 1,
        "on-click": "~/.scripts/toggle_calendar.sh"
    },

    "custom/cpu_status": {
        "exec": "~/.config/waybar/scripts/cpu_status.sh",
        "interval": 2,
        "tooltip": false
    },

    "memory": {
        "format": "[RAM:{percentage}%]",
        "interval": 2,
        "tooltip": true,
        "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G"
    },

    "custom/gpu_compact": {
        "exec": "~/.config/waybar/scripts/gpu_compact.sh",
        "interval": 2,
        "tooltip": false
    },

    "disk": {
        "path": "/",
        "format": "[DSK:{percentage_used}%]",
        "interval": 30,
        "tooltip": true,
        "tooltip-format": "Disk /: {used} used / {total} total"
    },

    "network": {
        "format-wifi": "[NET:{essid}]",
        "format-ethernet": "[NET:{ifname}]",
        "format-disconnected": "[NET:OFF]",
        "tooltip": true,
        "tooltip-format": "{ifname}\nIP: {ipaddr}\nDown: {bandwidthDownBytes}\nUp: {bandwidthUpBytes}",
        "interval": 2
    },

    "pulseaudio": {
        "format": "[VOL:{volume}%]",
        "format-muted": "[VOL:M]",
        "on-click": "~/.scripts/toggle_volume.sh",
        "on-click-right": "pavucontrol",
        "tooltip": true,
        "tooltip-format": "{desc}\nVolume: {volume}%"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "~/.config/waybar/power_menu.xml",
        "menu-actions": {
            "lock": "hyprlock",
            "suspend": "systemctl suspend",
            "reboot": "systemctl reboot",
            "shutdown": "systemctl poweroff"
        }
    }
}
