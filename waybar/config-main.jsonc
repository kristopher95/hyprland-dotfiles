{
    "layer": "top",
    "output": "DP-3",
    "position": "top",
    "height": 32,
    "spacing": 0,

    "modules-left": [
    "hyprland/workspaces",
    "custom/spotify-window",
    "custom/spotify-prev",
    "custom/spotify-toggle",
    "custom/spotify-next",
    "custom/spotify-vol-down",
    "custom/spotify-volume",
    "custom/spotify-vol-up",
    "custom/spotify-title",
    "custom/audio-bars"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "custom/ram",
        "custom/cpu",
        "custom/gpu",
        "pulseaudio",
        "network",
        "wlr/taskbar",
        "custom/power"
    ],

    "hyprland/workspaces": {
        "disable-scroll": true,
        "all-outputs": false,
        "format": "{name}",
        "persistent-workspaces": {
        "DP-3": [1, 2, 3, 4, 5, 6, 7, 8]
        }
    },

    "clock": {
        "format": "{:%a %b %d  %I:%M %p}",
        "tooltip": false,
        "on-click": "~/.scripts/toggle_calendar.sh"
    },

    "custom/ram": {
        "exec": "~/.config/waybar/scripts/ram.sh",
        "interval": 2,
        "return-type": "json",
        "tooltip": true
    },

    "custom/cpu": {
        "exec": "~/.config/waybar/scripts/cpu.sh",
        "interval": 2,
        "return-type": "json",
        "tooltip": true
    },

    "custom/gpu": {
        "exec": "~/.config/waybar/scripts/gpu.sh",
        "interval": 2,
        "tooltip": false
    },

    "custom/disk": {
        "exec": "~/.config/waybar/scripts/disk.sh",
        "interval": 2,
        "tooltip": false
    },

    "custom/net": {
        "exec": "~/.config/waybar/scripts/net.sh",
        "interval": 2,
        "tooltip": false
    },

    "pulseaudio": {
        "format": "[VOL: {volume}%]",
        "format-muted": "[VOL: MUTED]",
        "on-click": "~/.scripts/toggle_volume.sh",
        "on-click-right": "pavucontrol",
        "tooltip": false
    },

    "network": {
        "format-wifi": "[WIFI: {essid}]",
        "format-ethernet": "[ETH]",
        "format-disconnected": "[OFFLINE]",
        "tooltip-format": "{ifname} via {gwaddr}",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}: {ipaddr}/{cidr}"
    },

    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 16,
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close"
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "~/.config/waybar/power_menu.xml",
        "menu-actions": {
            "suspend": "systemctl suspend",
            "lock": "hyprlock",
            "reboot": "systemctl reboot",
            "shutdown": "systemctl poweroff"
        }
    },

    "custom/spotify-vol-down": {
        "format": "󰝞",
        "on-click": "playerctl -p spotify volume 0.05-",
        "tooltip": false
    },

    "custom/spotify-volume": {
        "exec": "~/.config/waybar/scripts/spotify_volume.sh",
        "interval": 1,
        "on-scroll-up": "playerctl -p spotify volume 0.05+",
        "on-scroll-down": "playerctl -p spotify volume 0.05-",
        "tooltip": false
    },

    "custom/spotify-vol-up": {
        "format": "󰝝",
        "on-click": "playerctl -p spotify volume 0.05+",
        "tooltip": false
    },

    "custom/spotify-prev": {
    "format": "󰒮",
    "on-click": "playerctl -p spotify previous",
    "tooltip": false
},

"custom/spotify-toggle": {
    "exec": "~/.config/waybar/scripts/spotify_status.sh",
    "interval": 1,
    "on-click": "playerctl -p spotify play-pause",
    "tooltip": false
},

"custom/spotify-next": {
    "format": "󰒭",
    "on-click": "playerctl -p spotify next",
    "tooltip": false
},

"custom/spotify-title": {
    "exec": "~/.config/waybar/scripts/spotify_title.sh",
    "interval": 1,
    "return-type": "json",
    "tooltip": true
},

    "custom/audio-bars": {
        "exec": "~/.config/waybar/scripts/audio_bars.sh",
        "tooltip": false
    },

    "custom/spotify-window": {
        "format": "",
        "on-click": "~/.scripts/toggle_spotify.sh",
        "tooltip": true,
        "tooltip-format": "Open / hide Spotify"
    }
}
