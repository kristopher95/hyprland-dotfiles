{
    "output": "DP-1",
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 0,

    "modules-left": [
        "custom/ws11",
        "custom/ws12",
        "custom/ws13",
        "custom/ws14",
        "custom/ws15",
        "custom/ws16",
        "custom/ws17",
        "custom/ws18"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "custom/cpu_status",
        "memory",
        "custom/gpu_compact",
        "pulseaudio",
        "tray",
        "custom/power"
    ],

    "custom/ws11": {
        "exec": "~/.config/waybar/scripts/ws_button.sh 11 1",
        "return-type": "json",
        "escape": false,
        "interval": "once",
        "signal": 8,
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"11\" })' && pkill -RTMIN+8 waybar"
    },

    "custom/ws12": {
        "exec": "~/.config/waybar/scripts/ws_button.sh 12 2",
        "return-type": "json",
        "escape": false,
        "interval": "once",
        "signal": 8,
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"12\" })' && pkill -RTMIN+8 waybar"
    },

    "custom/ws13": {
        "exec": "~/.config/waybar/scripts/ws_button.sh 13 3",
        "return-type": "json",
        "escape": false,
        "interval": "once",
        "signal": 8,
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"13\" })' && pkill -RTMIN+8 waybar"
    },

    "custom/ws14": {
        "exec": "~/.config/waybar/scripts/ws_button.sh 14 4",
        "return-type": "json",
        "escape": false,
        "interval": "once",
        "signal": 8,
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"14\" })' && pkill -RTMIN+8 waybar"
    },

    "custom/ws15": {
        "exec": "~/.config/waybar/scripts/ws_button.sh 15 5",
        "return-type": "json",
        "escape": false,
        "interval": "once",
        "signal": 8,
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"15\" })' && pkill -RTMIN+8 waybar"
    },

    "custom/ws16": {
        "exec": "~/.config/waybar/scripts/ws_button.sh 16 6",
        "return-type": "json",
        "escape": false,
        "interval": "once",
        "signal": 8,
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"16\" })' && pkill -RTMIN+8 waybar"
    },

    "custom/ws17": {
        "exec": "~/.config/waybar/scripts/ws_button.sh 17 7",
        "return-type": "json",
        "escape": false,
        "interval": "once",
        "signal": 8,
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"17\" })' && pkill -RTMIN+8 waybar"
    },

    "custom/ws18": {
        "exec": "~/.config/waybar/scripts/ws_button.sh 18 8",
        "return-type": "json",
        "escape": false,
        "interval": "once",
        "signal": 8,
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"18\" })' && pkill -RTMIN+8 waybar"
    },

    "clock": {
        "format": "{:%I:%M %p}",
        "tooltip-format": "{:%A, %B %d, %Y\n\n%I:%M:%S %p}",
        "interval": 1,
        "on-click": "~/.scripts/toggle_calendar.sh"
    },

    "custom/cpu_status": {
        "exec": "~/.config/waybar/scripts/cpu_status.sh",
        "interval": 2,
        "tooltip": false
    },

    "memory": {
        "format": "[RAM:{percentage}%]",
        "interval": 2,
        "tooltip": true,
        "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G"
    },

    "custom/gpu_compact": {
        "exec": "~/.config/waybar/scripts/gpu_compact.sh",
        "interval": 2,
        "tooltip": false
    },

    "pulseaudio": {
        "format": "[VOL:{volume}%]",
        "format-muted": "[VOL:M]",
        "on-click": "~/.scripts/toggle_volume.sh",
        "on-click-right": "pavucontrol",
        "tooltip": true,
        "tooltip-format": "{desc}\nVolume: {volume}%"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "~/.config/waybar/power_menu.xml",
        "menu-actions": {
            "lock": "hyprlock",
            "suspend": "systemctl suspend",
            "reboot": "systemctl reboot",
            "shutdown": "systemctl poweroff"
        }
    }
}
