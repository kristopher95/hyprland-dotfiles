{
    "output": "DP-1",
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 0,

    "modules-left": [
        "custom/ws11",
        "custom/ws12",
        "custom/ws13",
        "custom/ws14",
        "custom/ws15",
        "custom/ws16",
        "custom/ws17",
        "custom/ws18",
        "custom/spotify-window",
        "custom/spotify-prev",
        "custom/spotify-toggle",
        "custom/spotify-next",
        "custom/spotify-vol-down",
        "custom/spotify-volume",
        "custom/spotify-vol-up",
        "custom/spotify-title",
        "custom/audio-bars"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "custom/ram_compact",
        "custom/cpu_compact",
        "custom/gpu_compact",
        "pulseaudio",
        "custom/power"
    ],

    "custom/ws11": {
        "exec": "~/.config/waybar/scripts/ws_button.sh 11 1",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"11\" })'"
    },

    "custom/ws12": {
        "exec": "~/.config/waybar/scripts/ws_button.sh 12 2",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"12\" })'"
    },

    "custom/ws13": {
        "exec": "~/.config/waybar/scripts/ws_button.sh 13 3",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"13\" })'"
    },

    "custom/ws14": {
        "exec": "~/.config/waybar/scripts/ws_button.sh 14 4",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"14\" })'"
    },

    "custom/ws15": {
        "exec": "~/.config/waybar/scripts/ws_button.sh 15 5",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"15\" })'"
    },

    "custom/ws16": {
        "exec": "~/.config/waybar/scripts/ws_button.sh 16 6",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"16\" })'"
    },

    "custom/ws17": {
        "exec": "~/.config/waybar/scripts/ws_button.sh 17 7",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"17\" })'"
    },

    "custom/ws18": {
        "exec": "~/.config/waybar/scripts/ws_button.sh 18 8",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "tooltip": true,
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = \"18\" })'"
    },

    "clock": {
        "format": "{:%I:%M %p}",
        "tooltip-format": "{:%A, %B %d, %Y}",
        "on-click": "~/.scripts/toggle_calendar.sh"
    },

    "custom/ram_compact": {
        "exec": "~/.config/waybar/scripts/ram_compact.sh",
        "interval": 2,
        "tooltip": false
    },

    "custom/cpu_compact": {
        "exec": "~/.config/waybar/scripts/cpu_compact.sh",
        "interval": 2,
        "tooltip": false
    },

    "custom/gpu_compact": {
        "exec": "~/.config/waybar/scripts/gpu_compact.sh",
        "interval": 2,
        "tooltip": false
    },

    "pulseaudio": {
        "format": "[V:{volume}%]",
        "format-muted": "[V:M]",
        "on-click": "~/.scripts/toggle_volume.sh",
        "on-click-right": "pavucontrol",
        "tooltip": false
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "menu": "on-click",
        "menu-file": "~/.config/waybar/power_menu.xml",
        "menu-actions": {
            "lock": "hyprlock",
            "suspend": "systemctl suspend",
            "reboot": "systemctl reboot",
            "shutdown": "systemctl poweroff"
        }
    },

    "custom/spotify-prev": {
        "format": "󰒮",
        "on-click": "playerctl -p spotify previous",
        "tooltip": false
    },

    "custom/spotify-toggle": {
        "exec": "~/.config/waybar/scripts/spotify_status.sh",
        "interval": 1,
        "on-click": "playerctl -p spotify play-pause",
        "tooltip": false
    },

    "custom/spotify-next": {
        "format": "󰒭",
        "on-click": "playerctl -p spotify next",
        "tooltip": false
    },

    "custom/spotify-vol-down": {
        "format": "󰝞",
        "on-click": "playerctl -p spotify volume 0.05-",
        "tooltip": false
    },

    "custom/spotify-volume": {
        "exec": "~/.config/waybar/scripts/spotify_volume.sh",
        "interval": 1,
        "on-scroll-up": "playerctl -p spotify volume 0.05+",
        "on-scroll-down": "playerctl -p spotify volume 0.05-",
        "tooltip": false
    },

    "custom/spotify-vol-up": {
        "format": "󰝝",
        "on-click": "playerctl -p spotify volume 0.05+",
        "tooltip": false
    },

    "custom/spotify-title": {
        "exec": "~/.config/waybar/scripts/spotify_title.sh",
        "interval": 1,
        "return-type": "json",
        "tooltip": true
    },

    "custom/audio-bars": {
        "exec": "~/.config/waybar/scripts/audio_bars.sh",
        "tooltip": false
    },

    "custom/spotify-window": {
        "format": "",
        "on-click": "~/.scripts/toggle_spotify.sh",
        "tooltip": true,
        "tooltip-format": "Open / hide Spotify"
    }
}
