# ~/.config/mako/config

# Position
anchor=top-right
margin=12
width=420
height=120
padding=12
border-size=2
border-radius=0

# Font
font=JetBrainsMono Nerd Font 11

# Colors
background-color=#111318dd
text-color=#e6e6e6
border-color=#33ccffee
progress-color=over #00ff99ee

# Behavior
default-timeout=5000
ignore-timeout=0
max-visible=5
sort=-time

# Icons
icons=1
max-icon-size=48

# Actions
markup=1
actions=1
history=1

# Urgency: low
[urgency=low]
background-color=#111318cc
text-color=#b8b8b8
border-color=#595959aa
default-timeout=3000

# Urgency: normal
[urgency=normal]
background-color=#111318dd
text-color=#e6e6e6
border-color=#33ccffee
default-timeout=5000

# Urgency: critical
[urgency=critical]
background-color=#1a0f12ee
text-color=#ffffff
border-color=#ff5555ee
default-timeout=0
