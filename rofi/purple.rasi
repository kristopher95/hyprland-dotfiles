/******************************************************************************
 * Custom ROFI theme
 * Purple / JetBrainsMono Nerd Font / Papirus-Dark icons
 ******************************************************************************/

configuration {
    show-icons: true;
    icon-theme: "Papirus-Dark";
}

* {
    font:                         "JetBrainsMono Nerd Font 15";

    selected-normal-foreground:   rgba ( 255, 255, 255, 100 % );
    foreground:                   rgba ( 220, 220, 220, 100 % );
    normal-foreground:            @foreground;
    alternate-normal-foreground:  @foreground;

    normal-background:            rgba ( 47, 30, 46, 70 % );
    alternate-normal-background:  rgba ( 55, 35, 55, 65 % );
    selected-normal-background:   rgba ( 129, 91, 164, 55 % );

    urgent-foreground:            rgba ( 239, 97, 85, 100 % );
    urgent-background:            rgba ( 47, 30, 46, 20 % );
    alternate-urgent-background:  rgba ( 47, 30, 46, 20 % );
    alternate-urgent-foreground:  @urgent-foreground;
    selected-urgent-foreground:   rgba ( 255, 180, 170, 100 % );
    selected-urgent-background:   rgba ( 129, 91, 164, 55 % );

    active-foreground:            rgba ( 170, 125, 220, 100 % );
    active-background:            rgba ( 47, 30, 46, 20 % );
    alternate-active-background:  rgba ( 47, 30, 46, 20 % );
    alternate-active-foreground:  @active-foreground;
    selected-active-foreground:   rgba ( 230, 210, 255, 100 % );
    selected-active-background:   rgba ( 129, 91, 164, 55 % );

    red:                          rgba ( 220, 50, 47, 100 % );
    blue:                         rgba ( 38, 139, 210, 100 % );

    background:                   rgba ( 35, 22, 35, 97 % );
    background-color:             rgba ( 0, 0, 0, 0 % );

    bordercolor:                  rgba ( 180, 120, 220, 55 % );
    border-color:                 @bordercolor;
    separatorcolor:               rgba ( 180, 120, 220, 30 % );

    lightbg:                      rgba ( 238, 232, 213, 100 % );
    lightfg:                      rgba ( 88, 104, 117, 100 % );

    spacing:                      8;
}

window {
    background-color: @background;
    border:           2px;
    border-color:     @bordercolor;
    padding:          18px;
    width:            720px;
}

mainbox {
    border:  0;
    padding: 0;
    spacing: 12px;
}

message {
    border:       1px dash 0px 0px;
    border-color: @separatorcolor;
    padding:      8px;
}

textbox {
    text-color: @foreground;
}

listview {
    fixed-height: 0;
    border:       1px dash 0px 0px;
    border-color: @separatorcolor;
    spacing:      6px;
    scrollbar:    true;
    padding:      8px 0px 0px;
    lines:        10;
    columns:      1;
}

element {
    border:      0;
    padding:     9px 12px;
    spacing:     12px;
    orientation: horizontal;
}

element-icon {
    size:             28px;
    background-color: inherit;
}

element-text {
    background-color: inherit;
    text-color:       inherit;
    vertical-align:   0.5;
}

element.normal.normal {
    background-color: @normal-background;
    text-color:       @normal-foreground;
}

element.normal.urgent {
    background-color: @urgent-background;
    text-color:       @urgent-foreground;
}

element.normal.active {
    background-color: @active-background;
    text-color:       @active-foreground;
}

element.selected.normal {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
}

element.selected.urgent {
    background-color: @selected-urgent-background;
    text-color:       @selected-urgent-foreground;
}

element.selected.active {
    background-color: @selected-active-background;
    text-color:       @selected-active-foreground;
}

element.alternate.normal {
    background-color: @alternate-normal-background;
    text-color:       @alternate-normal-foreground;
}

element.alternate.urgent {
    background-color: @alternate-urgent-background;
    text-color:       @alternate-urgent-foreground;
}

element.alternate.active {
    background-color: @alternate-active-background;
    text-color:       @alternate-active-foreground;
}

scrollbar {
    width:        5px;
    border:       0;
    handle-width: 5px;
    padding:      0;
}

mode-switcher {
    border:       1px dash 0px 0px;
    border-color: @separatorcolor;
}

button.selected {
    background-color: @selected-normal-background;
    text-color:       @selected-normal-foreground;
}

inputbar {
    spacing:    8px;
    text-color: @normal-foreground;
    padding:    10px 12px;
    children:   [ prompt, textbox-prompt-colon, entry, case-indicator ];
}

case-indicator {
    spacing:    0;
    text-color: @normal-foreground;
}

entry {
    spacing:           0;
    text-color:        @normal-foreground;
    placeholder:       "Search";
    placeholder-color: rgba ( 160, 160, 160, 70 % );
}

prompt {
    spacing:    0;
    text-color: rgba ( 230, 210, 255, 100 % );
}

textbox-prompt-colon {
    expand:     false;
    str:        ":";
    margin:     0px 0.5em 0em 0em;
    text-color: @normal-foreground;
}
